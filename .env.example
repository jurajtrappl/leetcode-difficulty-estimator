# Copy to .env and fill in. Never commit .env.

# LeetCode session cookie (browser dev tools -> Cookies -> LEETCODE_SESSION), used by data/leetcode_graphql.py
LEETCODE_SESSION=

# Hugging Face access token (https://huggingface.co/settings/tokens), used by llama2-few-shot-leetcode.ipynb
HF_TOKEN=

# --- Optional: override shared settings from config.py (field name in upper case) ---
# Run `python config.py` to see all settings and their current values.
# SEED=42
# SAMPLE_LIMIT=300          # quick dry run on a stratified sample of 300 problems (0 = all)
# TEST_SIZE=0.2
# CV_FOLDS=5
# CLASS_WEIGHTING=balanced  # or none
# KEEP_SUPERSCRIPTS=true
# LAYA_MODEL=convaiinnovations/laya

# --- Optional: experiment tracking with MLflow (see tracking.py) ---
# TRACKING_ENABLED=true                       # false = run without logging
# MLFLOW_EXPERIMENT_PREFIX=leetcode-difficulty-estimator
# MLFLOW_TRACKING_URI=                        # empty = local store in ./mlflow; or http://localhost:5050
# MLFLOW_PORT=5050                           # port of the MLflow UI container (docker-compose.yml)
